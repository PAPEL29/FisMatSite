---
import Layout from '../layouts/MainLayout.astro';
import '/public/css/reglamentos.css';
---

<Layout title="reglementos">
        <!-- HERO -->
    <div class="instalaciones-hero">
        <span class="badge">Normatividad</span>
        <h1>Reglamento de la Facultad</h1>
        <p>
            Normas y disposiciones que regulan la vida académica de nuestra comunidad
        </p>

        
    </div>


    <section class="reglamento">

    <div class="reglamento-grid">

        <!-- IZQUIERDA -->
        <div class="reglamento-main">

            <h2>Reglamento interno</h2>
            <p class="update">Última actualización: Enero 2025</p>

            <!-- ACORDEÓN -->
            <div class="accordion">

                <div class="acc-item active">
                    <div class="acc-title">Título I - Disposiciones Generales</div>
                    <div class="acc-content">

                        <div class="articulo">
                            <h4>Artículo 1</h4>
                            <p>Normas académicas y administrativas.</p>
                        </div>

                        <div class="articulo">
                            <h4>Artículo 2</h4>
                            <p>Aplicación obligatoria.</p>
                        </div>

                        <div class="articulo">
                            <h4>Artículo 3</h4>
                            <p>Principios institucionales.</p>
                        </div>

                    </div>
                </div>

                <div class="acc-item">
                    <div class="acc-title">Título II - Admisión</div>
                    <div class="acc-content">
                        <p>Contenido del título II...</p>
                    </div>
                </div>

                <div class="acc-item">
                    <div class="acc-title">Título III - Actividades</div>
                    <div class="acc-content">
                        <p>Contenido del título III...</p>
                    </div>
                </div>

            </div>

        </div>

        <!-- DERECHA -->
        <div class="reglamento-side">

            <div class="side-card red">
                <h4>Importante</h4>
                <p>Es responsabilidad del estudiante conocer el reglamento.</p>
            </div>

            <div class="side-card">
                <h4>Reglamentos</h4>
                <a href="https://secretariageneral.umich.mx/normatividad">
                    <button>
                        <span class="shadow"></span>
  <span class="edge"></span>
  <span class="front text"> Normatividad Universitaria
  </span>
                    </button>
                </a>
                <a href="">
                    <button>
                        <span class="shadow"></span>
  <span class="edge"></span>
  <span class="front text"> Reglamento de Titulación Por Examen General de Conocimientos
  </span>
                    </button>
                </a>
                <a href="">
                    <button>
                        <span class="shadow"></span>
  <span class="edge"></span>
  <span class="front text"> Reglamento Interno del Honorable Consejo Tecnico
  </span>
                    </button>
                </a>
                <a href="">
                    <button>
                        <span class="shadow"></span>
  <span class="edge"></span>
  <span class="front text"> Reglamento de biblioteca
  </span>
                    </button>
                </a>
                <a href="">
                    <button>
                        <span class="shadow"></span>
  <span class="edge"></span>
  <span class="front text"> Reglamento de Servivio Social
  </span>
                    </button>
                </a>

                <a href="">
                    <button>
                        <span class="shadow"></span>
  <span class="edge"></span>
  <span class="front text"> Manual de Organización y Funciones
  </span>
                    </button>
                </a>


                
            </div>

            <div class="download-card">
                <h4>Descargar Reglamento Interno </h4>
                <a href="https://www.umich.mx/docs_normatividad/Reglamento%20Interno%20de%20la%20Universidad%20Michoacana%20de%20San%20Nicolas%20de%20Hidalgo.pdf">
                    <button class="btn-main">Descargar PDF</button>
                </a>
            </div>

        </div>

    </div>

</section>

    <script src="/public/js/reglamentos.js" defer></script>
</Layout>
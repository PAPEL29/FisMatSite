---
import Layout from '../layouts/Layout.astro';
---

<Layout title="programadelicenciatura">
    <link rel="stylesheet" href="/css/programadelicenciatura.css">
        <!-- HERO -->
    <div class="instalaciones-hero">
        <span class="badge">Facultad de Ciencias Físico-Matemáticas "Mat. Luis Manuel Rivera"</span>
        <h1>Facultad de Ciencias Físico-Matemáticas</h1>
        <p>
            Programa integral que combina formación en física y matemáticas, preparando profesionales con sólidas bases teóricas y experimentales para enfrentar los desafíos científicos y tecnológicos del siglo XXI.
        </p>

        <div class="tags">
            <span>Programa de Licenciatura</span>
            
        </div>
    </div>


    <section class="programa">

    <!-- TOP INFO -->
    <div class="top-info">
        <div class="info-box blue">Duración<br><strong>8 semestres</strong></div>
        <div class="info-box blue">Créditos<br><strong>350 créditos</strong></div>
        <div class="info-box blue">Modalidad<br><strong>Presencial</strong></div>
    </div>

    <!-- AREAS -->
    <div class="areas">
        <h2>Áreas terminales</h2>
        <p>Desarrolla competencias en disciplinas físico-matemáticas</p>

        <div class="tags">
            <span>Física </span>
            <span>Matemáticas</span>
            <span>Híbrida</span>
        </div>
        <p>.</p>
        <h2>Objetivo general</h2>
        <p>Formar Licenciados en Ciencias Físico Matemáticas con altos estándares de calidad para las competencias genéricas y disciplinares asociadas a los ámbitos: conceptual, técnico-metodológico, contextual-integrativo y ético-personal, que los habiliten para comprender, evaluar, formular, prevenir e intervenir en distintos desafíos que se presentan en los ámbitos: de la ciencia y la tecnología, la educación y la sociedad.</p>
    </div>
</section>

<section class="programa">
    <!-- DISTINGUE -->
    <div class="distinguido">
        <h2>Lo que nos Distingue</h2>

        <div class="cards">
            <div class="card">
                <div class="icon">
                     <i class="fa-solid fa-user-graduate"></i>
                </div>
                Excelencia Académica
            </div>
            <div class="card red">
                <div class="icon">
                     
                    <i class="fa-solid fa-users"></i>
                </div>
                Grupos Reducidos
            </div>
            <div class="card">
                <div class="icon">
                    <i class="fa-solid fa-microscope"></i>
                </div>
                Investigación Activa
            </div>
            <div class="card red">
                <div class="icon">
                    <i class="fa-solid fa-newspaper"></i>
                </div>
                Flexibilidad Curricular
            </div>
        </div>
    </div>
</section>

<section class="programa">

    <!-- GRID INFERIOR -->

        <div class="box">
            <h3>Oportunidades Profesionales</h3>
            <ul>
                <li>Investigación científica</li>
                <li>Docencia universitaria</li>
                <li>Industria tecnológica</li>
                <li>Análisis de datos</li>
            </ul>
        </div>

        <!-- REQUISITOS -->
        <div class="box">
            <h3>Requisitos de Ingreso</h3>
            <ul>

---
import Layout from '../layouts/Layout.astro';
import '/css/posgrado.css';
---

<Layout title="posgrado">
    
<section class="posgrado">

    <!-- HERO -->
    <div class="posgrado-hero">
        <span class="badge">Educación de Excelencia</span>
        <h1>Programas de Posgrado</h1>
        <p>
            Formamos investigadores de alto nivel a través de programas acreditados internacionalmente.
        </p>

        <div class="tags">
            <span>ABET</span>
            <span>EUR-ACE</span>
            <span>PNPC-CONACYT</span>
        </div>
    </div>

    <!-- PROGRAMAS -->
    <div class="programas">

        <h2>Nuestros Programas</h2>
        <p>Cuatro programas de posgrado de calidad internacional</p>

        <div class="programas-grid">

            <!-- CARD 1 -->
            <div class="programa-card blue">
                <h3>Maestría en Ingeniería Física</h3>
                <ul>
                    <li> <i class="fas fa-clock"></i> Duración: 2 años</li>
                    <li> <i class="fas fa-users"></i> Modalidad: Tiempo completo</li>
                    <li> <i class="fas fa-award"></i> Acreditación: ABET, EUR-ACE, PNPC</li>
                </ul>
                <a href="https://www.ifm.umich.mx/oferta-educativa/maestria-en-ciencias-en-el-area-fisica/plan-de-estudios-mcaf" > 
                    <button class="btn-outline">Ver plan de estudios →</button>
                </a>
            </div>

            <!-- CARD 2 -->
            <div class="programa-card blue">
                <h3>Doctorado en Ingeniería Física</h3>
                <ul>
                    <li> <i class="fas fa-clock"></i>Duración: 4 años</li>
                    <li> <i class="fas fa-users"></i> Modalidad: Tiempo completo</li>
                    <li> <i class="fas fa-award"></i> Acreditación: ABET, EUR-ACE, PNPC</li>
                </ul>
                <a href="https://www.ifm.umich.mx/oferta-educativa/doctorado-en-ciencias-en-el-%C3%A1rea-f%C3%ADsica/plan-de-estudios-dcaf">
                    <button class="btn-outline red">Ver plan de estudios →</button>
                </a>
            </div>

            <!-- CARD 3 -->
            <div class="programa-card lightblue">
                <h3>Maestría en Ciencias Matemáticas</h3>
                <ul>
                    <li> <i class="fas fa-clock"></i> Duración: 2 años</li>
                    <li> <i class="fas fa-users"></i> Modalidad: Tiempo completo</li>
                    <li> <i class="fas fa-award"></i> Acreditación: ABET, EUR-ACE, PNPC</li>
                </ul>
                <a href="https://tic.matmor.unam.mx/pccm/maestria">
                    <button class="btn-outline">Ver plan de estudios →</button>
                </a>
            </div>

            <!-- CARD 4 -->
            <div class="programa-card lightblue">
                <h3>Doctorado en Ciencias Matemáticas</h3>
                <ul>
                    <li> <i class="fas fa-clock"></i> Duración: 4 años</li>
                    <li> <i class="fas fa-users"></i> Modalidad: Tiempo completo</li>
                    <li> <i class="fas fa-award"></i> Acreditación: ABET, EUR-ACE, PNPC</li>
                </ul>
                <a href="https://tic.matmor.unam.mx/pccm/doctorado">
                    <button class="btn-outline red">Ver plan de estudios →</button>
                </a>
            </div>

        </div>

    </div>

</section>







<section class="research-section">
    <div class="research-header">
        <span class="research-badge-top"><i class="fas fa-microscope"></i> Investigación de Frontera</span>
        <h2>Líneas de Investigación</h2>
        <p>Nuestros programas de posgrado abarcan diversas líneas de investigación de vanguardia con impacto internacional</p>
    </div>

    <div class="research-category">
        <h3 class="category-title">Ingeniería Física</h3>
        
        <div class="research-card border-dark-blue">
            <div class="card-icon-box"><i class="fas fa-atom"></i></div>
            <div class="card-main-content">
                <div class="card-header-row">
                    <h4>Física de Partículas y Altas Energías</h4>
                    <div class="card-tags">
                        <span class="tag-outline">12 investigadores</span>
                        <span class="tag-outline">8 proyectos</span>
                    </div>
                </div>
                <p>Investigación en física de partículas elementales, colaboración con CERN, análisis de datos de colisionadores y desarrollo de detectores.</p>
            </div>
        </div>

        <div class="research-card border-red">
            <div class="card-icon-box"><i class="fas fa-globe-americas"></i></div>
            <div class="card-main-content">
                <div class="card-header-row">
                    <h4>Astrofísica y Cosmología</h4>
                    <div class="card-tags">
                        <span class="tag-outline-red">10 investigadores</span>
                        <span class="tag-outline-red">6 proyectos</span>
                    </div>
                </div>
                <p>Estudio de fenómenos cósmicos, materia oscura, energía oscura, formación de galaxias y estructura a gran escala del universo.</p>
            </div>
        </div>

        <div class="research-card border-light-blue">
            <div class="card-icon-box"><i class="fas fa-flask"></i></div>
            <div class="card-main-content">
                <div class="card-header-row">
                    <h4>Física de Materiales y Nanotecnología</h4>
                    <div class="card-tags">
                        <span class="tag-outline-blue">15 investigadores</span>
                        <span class="tag-outline-blue">12 proyectos</span>
                    </div>
                </div>
                <p>Desarrollo y caracterización de nuevos materiales, nanoestructuras, materiales 2D, superconductores y aplicaciones tecnológicas.</p>
            </div>
        </div>
    </div>
</section>









<section class="labs">

    <!-- HEADER -->
    <div class="labs-header">
        <span class="badge blue">Infraestructura</span>
        <h2>Laboratorios de Investigación</h2>
        <p>Instalaciones de vanguardia equipadas con tecnología de última generación</p>
    </div>

    <!-- GRID -->
    <div class="labs-grid">

        <!-- CARD -->
        <div class="lab-card blue">
            <h3>Laboratorio de Electromagnetismo</h3>
            <p>Campos electromagnéticos, ondas y circuitos RF.</p>

            <div class="lab-info">
                <span>Equipamiento: 15+ estaciones</span>
                <span>Área: 120 m²</span>
                <span class="badge small">45</span>
            </div>
        </div>

        <div class="lab-card red">
            <h3>Laboratorio de Mecánica Avanzada</h3>
            <p>Dinámica, fluidos, vibraciones.</p>

            <div class="lab-info">
                <span>Equipamiento: 12+ equipos</span>
                <span>Área: 100 m²</span>
                <span class="badge small red">35</span>
            </div>
        </div>

        <div class="lab-card lightblue">
            <h3>Laboratorio de Óptica y Fotónica</h3>
            <p>Láseres, interferometría y fibras ópticas.</p>

            <div class="lab-info">
                <span>Equipamiento: 20+ sistemas</span>
                <span>Área: 140 m²</span>
                <span class="badge small blue">40</span>
            </div>
        </div>

        <div class="lab-card dark">
            <h3>Laboratorio de Computación Científica</h3>
            <p>Clusters y simulación avanzada.</p>

            <div class="lab-info">
                <span>Equipamiento: 50+ equipos</span>
                <span>Área: 180 m²</span>
                <span class="badge small dark">80</span>
            </div>
        </div>

        <div class="lab-card red">
            <h3>Laboratorio de Materiales</h3>
            <p>SEM, XRD, espectroscopía.</p>

            <div class="lab-info">
                <span>Equipamiento: 10+ instrumentos</span>
                <span>Área: 160 m²</span>
                <span class="badge small red">30</span>
            </div>
        </div>

    </div>

</section>









<section class="grad-stats-section">
    <div class="stats-header">
        <span class="indicators-badge"><i class="fas fa-chart-line"></i> Indicadores</span>
        <h2>Estadísticas de Posgrado</h2>
        <p>Cifras que reflejan nuestra excelencia académica y productividad científica</p>
    </div>

    <div class="grad-stats-grid">
        <div class="grad-card border-navy">
            <div class="grad-icon"><i class="fas fa-user-graduate"></i></div>
            <div class="grad-num counter" data-target="280">0</div>
            <div class="grad-label">Estudiantes de Posgrado</div>
        </div>

        <div class="grad-card border-red">
            <div class="grad-icon icon-red"><i class="fas fa-award"></i></div>
            <div class="grad-num counter" data-target="95" data-suffix="%">0</div>
            <div class="grad-label">Graduados con SNI</div>
        </div>

        <div class="grad-card border-blue">
            <div class="grad-icon icon-blue"><i class="fas fa-book"></i></div>
            <div class="grad-num num-blue counter" data-target="450" data-suffix="+">0</div>
            <div class="grad-label">Publicaciones/Año</div>
        </div>

        <div class="grad-card border-navy">
            <div class="grad-icon"><i class="fas fa-globe"></i></div>
            <div class="grad-num counter" data-target="40" data-suffix="+">0</div>
            <div class="grad-label">Convenios Internacionales</div>
        </div>

        <div class="grad-card border-red">
            <div class="grad-icon icon-red"><i class="fas fa-microscope"></i></div>
            <div class="grad-num num-red counter" data-target="85" data-suffix="+">0</div>
            <div class="grad-label">Proyectos de Investigación</div>
        </div>

        <div class="grad-card border-blue">
            <div class="grad-icon icon-blue"><i class="fas fa-chart-bar"></i></div>
            <div class="grad-num num-blue counter" data-target="100" data-suffix="%">0</div>
            <div class="grad-label">Inserción Laboral</div>
        </div>
    </div>

    <div class="reports-box">
        <div class="reports-icon"><i class="far fa-file-alt"></i></div>
        <h4>Consulta nuestros informes de productividad académica</h4>
        <div class="reports-btns">
            <button class="btn-report-dark"><i class="far fa-file-pdf"></i> Reporte Anual 2024</button>
            <button class="btn-report-red"><i class="fas fa-book-open"></i> Publicaciones</button>
        </div>
    </div>
</section>


    <script src="/public/js/posgrado.js" defer></script>
</Layout>